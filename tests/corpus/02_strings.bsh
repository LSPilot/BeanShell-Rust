p( x ) { this.interpreter.println( x ); }

String s = "Hello";
p(s.length());
p(s.substring(1, 3));
p(s.toUpperCase());
p(s.toLowerCase());
p(s.charAt(0));
p(s.indexOf("l"));
p(s.lastIndexOf("l"));
p(s.replace('l', 'L'));
p(s.replace("ll", "LL"));
p(s.equals("Hello"));
p(s.startsWith("He"));
p(s.endsWith("lo"));
p("  pad  ".trim() + "|");
p("a,b,c".split(",").length);
p("abc".contains("b"));
p(String.valueOf(42));
p(String.valueOf(true));
p("n=" + 42);
p(1 + 2 + "x");
p('x' + 1);
p('x' + "y");
p("abc".compareTo("abd"));
p("abc".concat("def"));
